// PROPOSTA DE MODELAGEM — NÃO APLICAR MIGRAÇÕES EM PRODUÇÃO AINDA.
// Sintaxe planejada para Prisma ORM 6 + PostgreSQL/Supabase.
// Auth: usuários são autenticados pelo Supabase Auth. NUNCA gravar senhas aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  RESPONSAVEL
  PROFESSOR
  ADMIN
}

enum Programa {
  KIDS_01
  KIDS_02
}

enum SituacaoMatricula {
  ATIVA
  TRANCADA
  ENCERRADA
}

enum SituacaoPresenca {
  PRESENTE
  FALTA
  JUSTIFICADA
}

enum SituacaoAula {
  PREVISTA
  REALIZADA
  CANCELADA
}

enum SituacaoConteudoCurricular {
  EM_DESENVOLVIMENTO
  PUBLICADO
}

enum SituacaoDinamica {
  PLANEJADA
  REALIZADA
  CANCELADA
}

enum CategoriaPassaporte {
  ANIMAL
  CORPO
  PALAVRA_ANCORA
  LINGUAGEM_COMBATE
}

model Usuario {
  id             String           @id @default(uuid()) @db.Uuid
  authUserId     String           @unique @db.Uuid // Referência à auth.users do Supabase
  nome           String
  email          String           @unique
  papel          Papel
  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt
  responsaveis   VinculoResponsavel[]
  turmasProfessor ProfessorTurma[]
  avaliacoes     AvaliacaoPMA[]
  chamadas       Presenca[]       @relation("RegistroPresenca")
}

model Aluno {
  id              String                @id @default(uuid()) @db.Uuid
  nome            String
  fotoUrl         String?
  faixa           String
  programa        Programa
  criadoEm        DateTime              @default(now())
  atualizadoEm    DateTime              @updatedAt
  responsaveis    VinculoResponsavel[]
  matriculas      Matricula[]
  presencas       Presenca[]
  avaliacoes      AvaliacaoPMA[]
  progressoGraus  ProgressoGraus?
  conquistas      ConquistaPassaporte[]
}

// Um responsável pode ter vários alunos; um aluno pode ter mais de um responsável.
model VinculoResponsavel {
  responsavelId String  @db.Uuid
  alunoId       String  @db.Uuid
  parentesco    String?
  responsavel   Usuario @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  aluno         Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@id([responsavelId, alunoId])
}

model Turma {
  id           String           @id @default(uuid()) @db.Uuid
  nome         String
  programa     Programa
  horario      String?          // Rótulo temporário; futura agenda poderá ser normalizada.
  ativa        Boolean          @default(true)
  professores  ProfessorTurma[]
  matriculas   Matricula[]
  missaoAtualId String?           @db.Uuid
  missaoAtual   MissaoSemanal?    @relation("MissaoAtualTurma", fields: [missaoAtualId], references: [id])
  aulas        Aula[]
  dinamicasPlanejadas AplicacaoDinamica[]
}

model ProfessorTurma {
  professorId String  @db.Uuid
  turmaId     String  @db.Uuid
  professor   Usuario @relation(fields: [professorId], references: [id], onDelete: Cascade)
  turma       Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([professorId, turmaId])
}

model Matricula {
  alunoId    String            @db.Uuid
  turmaId    String            @db.Uuid
  situacao   SituacaoMatricula @default(ATIVA)
  criadaEm   DateTime          @default(now())
  aluno      Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma      Turma             @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([alunoId, turmaId])
}

model Aula {
  id                String               @id @default(uuid()) @db.Uuid
  turmaId           String               @db.Uuid
  dataInicio        DateTime
  duracaoMinutos    Int                  @default(64)
  situacao          SituacaoAula         @default(PREVISTA)
  missaoId          String?              @db.Uuid
  numeroEncontro    Int?                 // 1 ou 2, a validar na camada de serviço
  conteudoDiaId     String?              @db.Uuid
  turma             Turma                @relation(fields: [turmaId], references: [id])
  missao            MissaoSemanal?       @relation(fields: [missaoId], references: [id])
  habilidades       AulaHabilidade[]
  aplicacoesDinamica AplicacaoDinamica[]
  conteudoDia       ConteudoPassaporte?   @relation(fields: [conteudoDiaId], references: [id])
  presencas         Presenca[]
  conquistas        ConquistaPassaporte[]

  @@unique([turmaId, dataInicio])
  @@index([dataInicio])
}

model Presenca {
  id               String           @id @default(uuid()) @db.Uuid
  aulaId           String           @db.Uuid
  alunoId          String           @db.Uuid
  registradaPorId  String           @db.Uuid
  situacao         SituacaoPresenca
  atualizadaEm     DateTime         @updatedAt
  aula             Aula             @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  aluno            Aluno            @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  registradaPor    Usuario          @relation("RegistroPresenca", fields: [registradaPorId], references: [id])

  @@unique([aulaId, alunoId])
  @@index([alunoId, situacao])
}

model AvaliacaoPMA {
  id                String   @id @default(uuid()) @db.Uuid
  alunoId           String   @db.Uuid
  avaliadorId       String   @db.Uuid
  competencia       String   // YYYY-MM; validar no serviço
  moduloNome        String
  atencao           Int
  disciplina        Int
  respeito          Int
  tecnica           Int
  pmaComportamental Float
  pmaTecnico        Float
  pmaGeral          Float
  dataAvaliacao     DateTime @default(now())
  aluno             Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  avaliador         Usuario  @relation(fields: [avaliadorId], references: [id])

  @@unique([alunoId, competencia, moduloNome])
  @@index([alunoId, dataAvaliacao])
}

model ProgressoGraus {
  alunoId        String   @id @db.Uuid
  atencao        Int      @default(0)
  disciplina     Int      @default(0)
  respeito       Int      @default(0)
  frequencia     Int      @default(0)
  versaoRegra    String   @default("rascunho-v1")
  atualizadoEm   DateTime @updatedAt
  aluno          Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

// Currículo COMPARTILHADO entre Kids 01 e Kids 02.
// A diferenciação pedagógica está na condução da aula, não no cadastro de missões.
model ModuloCurricular {
  id             String                   @id @default(uuid()) @db.Uuid
  numero         Int                      @unique
  titulo         String
  tema           String?
  objetivoGeral  String?                  @db.Text
  resumoFamilia  String?                  @db.Text
  situacao       SituacaoConteudoCurricular @default(EM_DESENVOLVIMENTO)
  fonteNotionUrl String?
  missoes        MissaoSemanal[]
}

model MissaoSemanal {
  id                   String            @id @default(uuid()) @db.Uuid
  moduloId             String            @db.Uuid
  numero               Int               // 1 a 4 dentro do módulo
  titulo               String
  descricao            String?           @db.Text // Texto para os responsáveis
  tema                 String?           @db.Text
  objetivoPedagogico   String?           @db.Text
  fonteNotionUrl       String?
  modulo               ModuloCurricular  @relation(fields: [moduloId], references: [id])
  turmasAtuais         Turma[]            @relation("MissaoAtualTurma")
  aulas                Aula[]
  aplicacoesDinamicas  AplicacaoDinamica[]

  @@unique([moduloId, numero])
}

// A missão em andamento pertence à Turma, não ao aluno.
// A aplicação precisa validar que a missão está PUBLICADA e pertence ao
// módulo liberado antes de permitir alterações no banco real.

// Casas são HABILIDADES, não missões nem níveis de aprovação.
model CasaHabilidade {
  id             String               @id @default(uuid()) @db.Uuid
  numero         Int                  // 1 a 27 por programa
  programa       Programa
  titulo         String
  descricao      String?
  aulas          AulaHabilidade[]
  dinamicas      DinamicaHabilidade[]

  @@unique([programa, numero])
}

// Quais habilidades foram efetivamente trabalhadas nesta aula?
model AulaHabilidade {
  aulaId String        @db.Uuid
  casaId String        @db.Uuid
  aula   Aula          @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  casa   CasaHabilidade @relation(fields: [casaId], references: [id])

  @@id([aulaId, casaId])
}

model Dinamica {
  id              String               @id @default(uuid()) @db.Uuid
  nome            String
  descricao       String?
  duracaoMinutos  Int?
  materiais       String?
  programa        Programa?
  testada         Boolean              @default(false)
  ativa           Boolean              @default(true)
  habilidades     DinamicaHabilidade[]
  aplicacoes      AplicacaoDinamica[]
}

model DinamicaHabilidade {
  dinamicaId String         @db.Uuid
  casaId     String         @db.Uuid
  dinamica   Dinamica       @relation(fields: [dinamicaId], references: [id], onDelete: Cascade)
  casa       CasaHabilidade @relation(fields: [casaId], references: [id])

  @@id([dinamicaId, casaId])
}

// Dinâmica nunca sai do catálogo por ter sido utilizada.
// 'REALIZADA' é diferente de 'PLANEJADA'; aulaRealizadaId só é informado na execução.
model AplicacaoDinamica {
  id               String           @id @default(uuid()) @db.Uuid
  turmaId          String           @db.Uuid
  missaoId         String           @db.Uuid
  dinamicaId       String           @db.Uuid
  periodoLetivo    String           // Ex.: 2026.2 (validar/normalizar depois)
  situacao         SituacaoDinamica @default(PLANEJADA)
  aulaRealizadaId  String?          @db.Uuid
  planejadaEm      DateTime         @default(now())
  realizadaEm      DateTime?
  turma            Turma            @relation(fields: [turmaId], references: [id])
  missao           MissaoSemanal    @relation(fields: [missaoId], references: [id])
  dinamica         Dinamica         @relation(fields: [dinamicaId], references: [id])
  aulaRealizada    Aula?            @relation(fields: [aulaRealizadaId], references: [id])

  @@index([turmaId, periodoLetivo, situacao])
  @@index([dinamicaId, situacao, realizadaEm])
}

model ConteudoPassaporte {
  id          String               @id @default(uuid()) @db.Uuid
  categoria   CategoriaPassaporte
  termoBase   String
  traducoes   Json?                // Ex.: { "EN": "Eagle", "ES": "Águila" }
  aulas       Aula[]
  conquistas  ConquistaPassaporte[]
}

model ConquistaPassaporte {
  id          String             @id @default(uuid()) @db.Uuid
  alunoId     String             @db.Uuid
  conteudoId  String             @db.Uuid
  aulaId      String             @db.Uuid
  recebidoEm  DateTime           @default(now())
  aluno       Aluno              @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  conteudo    ConteudoPassaporte @relation(fields: [conteudoId], references: [id])
  aula        Aula               @relation(fields: [aulaId], references: [id])

  @@unique([alunoId, conteudoId, aulaId])
}
